{
  "name": "bscript",
  "private": true,
  "workspaces": [
    "cli",
    "lang",
    "notebook"
  ],
  "devDependencies": {
    "shx": "^0.4.0",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "tsc -b",
    "build:all": "tsc -b && npm run build -w @bscript/notebook"
  },
  "allowScripts": {
    "@abandonware/bluetooth-hci-socket": true,
    "@abandonware/noble": true,
    "@serialport/bindings-cpp": true,
    "usb": true,
    "usocket": true
  }
}
